# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# generated pronunciation audio (see docs/AUDIO.md) — mounted on the VPS, not committed
/audio-out/
# reading-mode story audio (generated by scripts/generate-story-audio.py, synced
# via scripts/sync-audio.py) — mounted like word audio, not committed
/public/audio/
# scripts/build-audio-pack.sh output — uploaded to GitHub Releases, not
# committed. audio/PACK_VERSIONS (the sibling file, NOT this dir) IS
# committed — the image reads it at boot.
/dist-audio-packs/
# raw font source: only the subsetted woff2 is committed as a runtime asset;
# the full .ttf and the subsetter's char list are build inputs (scripts/subset-font.py)
/public/fonts/*.ttf
/public/fonts/_subset_chars.txt

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# IDE
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma / sqlite
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm
# stray nested dir some scripts create when run with a relative DATABASE_URL
# from the wrong cwd (e.g. "file:./prisma/dev.db" run from inside prisma/)
/prisma/prisma/

# self-host: docker-compose.yml bind-mounts nightly SQLite backups here —
# real user data (emails, password hashes), never commit
/backups/

# Local security assessment records; may contain operational details.
/security-audits/

# local assistant config (not part of the app)
/CLAUDE.md
/.claude/
/.opencode/
/HANDOFF.md
# third-party agent skills (npx skills add) — local only, never published
/.agents/
/agent/
/skills-lock.json

# impeccable design skill working dir — critique snapshots, live-mode state, caches
/.impeccable/
# impeccable init output — local design-context notes, not part of the app
/PRODUCT.md
/DESIGN.md

# private launch/ops notes
/LAUNCH-CHECKLIST.md
/docs/marketing/

# Claude Code agent-skill definitions — internal tooling, not documentation
# for self-hosters/contributors. Purged from git history 2026-08-25.
/docs/skills/

# private product sequencing — deliberately NOT in the public RELEASES.md
# roadmap (see docs/marketing/positioning.md: multi-language is an
# architecture story, not a marketing promise we want to owe anyone).
/ROADMAP-INTERNAL.md

# private ops runbook
/LAUNCH-RUNBOOK.md
/LAUNCH-RUNBOOK.html

# one-off QA artifact from the HSK 2.0->3.0 data migration — internal dev
# record, not user-facing documentation
/docs/hsk-wordlist-diff-report.md

# local vocabulary-quality audit records (see audits/ README inside)
/audits/

# python bytecode cache
__pycache__/
*.pyc

# agent working notes — local only
/.learnings/
