generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // swap to "postgresql" for VPS deploy
  url      = env("DATABASE_URL")
}

enum SRSAlgorithmType {
  SM2
  LEITNER
  FSRS
}

enum CardState {
  NEW
  LEARNING
  REVIEW
  LAPSED
  MASTERED
  ASSUMED
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  passwordHash       String
  name               String?
  preferredAlgorithm SRSAlgorithmType @default(FSRS)
  settings           Json? // future: theme, daily limits, etc.
  theme              String           @default("system") // "light" | "dark" | "system"
  studyTheme         String           @default("follow") // "dark" = forced focus mode | "follow" = match app theme
  cardTextSize       String           @default("normal") // "small" | "normal" | "large" — study card text scale
  characterStyle     String           @default("modern") // "modern" (Hei/sans) | "academic" (Song/serif) — study card term font
  showReading        Boolean          @default(true) // false = flashcards skip the reading hint stage
  soundEffects       Boolean          @default(true) // false = mute study sound effects
  autoPlayPronunciation Boolean       @default(true) // speak the term when its reading is revealed

  // Learning limits
  dailyNewWords      Int @default(10) // new cards introduced per day; 0 = pause learning
  assumedCheckPerDay Int @default(3) // ASSUMED words reintroduced per day

  // Algorithm tuning
  intervalModifier     Float   @default(1.0) // success-interval multiplier
  lapseModifier        Float   @default(0.0) // post-lapse interval = prevInterval * this
  masteryThresholdDays Int? // interval >= this => MASTERED, stop scheduling; null = never
  fuzzIntervals        Boolean @default(true) // +/-5% interval randomization
  desiredRetention     Float   @default(0.90) // FSRS desired retention target

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  passwordChangedAt DateTime @default(now())
  emailVerified DateTime?

  // Hosted billing (ignored entirely when SELF_HOSTED=true)
  stripeCustomerId   String?   @unique
  subscriptionStatus String    @default("trialing") // "trialing" | "active" | "canceled" | "past_due"
  trialEndsAt        DateTime? // null = no trial clock (self-host / legacy)
  billingConsentAt   DateTime? // EU withdrawal-right acknowledgment timestamp

  progress            UserProgress[]
  reviewLogs          ReviewLog[]
  wordLists           WordList[]
  languages           Language[]
  feedback            Feedback[]
  hiddenLists         HiddenList[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  VerificationToken[]
  emailLogs           EmailLog[]
  listPriorities      ListPriority[]
  readingProgress     ReadingProgress[]
  readingSessions     ReadingSession[]
  wordEncounters      WordEncounter[]

  targetLanguageId    String?
  targetLanguage      Language?  @relation("UserTargetLanguage", fields: [targetLanguageId], references: [id])
}

model Language {
  id          String  @id @default(cuid())
  name        String // "Mandarin Chinese"
  code        String  @unique // "zh", "ja", "es"
  createdById String? // null = seeded/global; otherwise owned by the user who added it

  createdBy User?      @relation(fields: [createdById], references: [id])
  wordLists WordList[]
  sentences Sentence[]
  readingTexts ReadingText[]
  encounters WordEncounter[]
  targetedByUsers User[] @relation("UserTargetLanguage")

  @@index([createdById])
}

model WordList {
  id          String   @id @default(cuid())
  name        String
  description String?
  languageId  String
  isPublic    Boolean  @default(false) // private by default; seed + share paths set true explicitly
  createdById String? // null = seeded/public; otherwise owned by this user
  createdAt   DateTime @default(now())

  language  Language     @relation(fields: [languageId], references: [id])
  createdBy User?        @relation(fields: [createdById], references: [id])
  words     Word[]
  hiddenBy  HiddenList[]
  priorities ListPriority[]

  @@index([languageId])
  @@index([createdById])
}

model Word {
  id          String  @id @default(cuid())
  term        String // target-language form
  translation String // user-language meaning
  phonetic    String? // romanization / reading / IPA — optional
  metadata    Json? // language-specific extras: tones, radicals, audio URL, pos, frequency rank
  wordListId  String
  position    Int     @default(0) // ordering within list

  wordList  WordList       @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  progress  UserProgress[]
  sentences SentenceWord[]

  @@index([wordListId])
}

model Sentence {
  id          String  @id @default(cuid())
  languageId  String
  text        String // target-language sentence
  translation String // user-language meaning
  phonetic    String? // reading / romanization — optional
  source      String? // attribution, e.g. "tatoeba.org #123 (user) CC-BY 2.0 FR"
  metadata    Json? // language-specific extras

  language Language       @relation(fields: [languageId], references: [id])
  words    SentenceWord[]

  @@unique([languageId, text])
}

// Links a sentence to each seeded/created word it exercises, so sentence
// practice can credit the word's existing SRS progress.
model SentenceWord {
  sentenceId String
  wordId     String

  sentence Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  word     Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([sentenceId, wordId])
  @@index([wordId])
}

model UserProgress {
  id     String @id @default(cuid())
  userId String
  wordId String

  // Algorithm-agnostic SRS state (superset of SM-2 + Leitner needs)
  state            CardState @default(NEW)
  easeFactor       Float     @default(2.5) // SM-2
  intervalDays     Float     @default(0) // SM-2
  repetitions      Int       @default(0) // SM-2 consecutive successes
  box              Int       @default(1) // Leitner box 1–5
  lapses           Int       @default(0)
  dueAt            DateTime  @default(now())
  lastReviewedAt   DateTime?
  introducedAt     DateTime? // set on first-ever review; drives daily new-word cap
  assumedCheckedAt DateTime? // set when an ASSUMED card is checked; drives daily assumed-check cap
  srsData          Json? // algorithm-specific overflow (future FSRS params, etc.)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, dueAt]) // hot path: "due today" queries
}

model ReviewLog {
  id             String           @id @default(cuid())
  userId         String
  guestId        String?
  wordId         String
  quality        Int // 0–5 scale; swipe left = 1, swipe right = 4
  algorithm      SRSAlgorithmType
  intervalBefore Float
  intervalAfter  Float
  reviewedAt     DateTime         @default(now())
  source         String           @default("srs") // "srs" | "quiz" | "match" | "sentences" | "ninja"
  latencyMs      Int? // time-to-response in milliseconds; null for untimed modes

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
}

model HiddenList {
  id     String @id @default(cuid())
  userId String
  listId String

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  list WordList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
}

// Per-user ordering of their "Studying" lists. rank is 0-based, lower = higher
// priority; feeds the study queue's new-card selection (src/lib/listPriority.ts).
model ListPriority {
  id         String   @id @default(cuid())
  userId     String
  wordListId String
  rank       Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordList WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)

  @@unique([userId, wordListId])
  @@index([userId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  category  String // "bug" | "idea" | "other" | "cancellation" | "word" (card-quality report from study mode)
  message   String
  page      String? // route the report was filed from, if provided
  status    String   @default("open") // "open" | "closed" — triaged via /mb-admin
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// One row per lifecycle email actually sent — the idempotency guard for
// the daily trial-email cron (never email the same user+kind twice).
model EmailLog {
  id     String   @id @default(cuid())
  userId String
  kind   String // "trial_welcome" | "trial_ending" | "trial_ended"
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email])
}

// Reading Mode — graded texts with karaoke audio and tap dictionary.
// Level semantics belong to the language (HSK band for zh); the column stays
// a plain Int so the model stays language-agnostic per the word contract.
model ReadingText {
  id           String   @id @default(cuid())
  languageId   String
  slug         String // stable filename-derived id, e.g. "hsk1-coffee-shop"
  title        String
  titleEn      String? // English translation for library browsing
  level        Int // target level the text was written/graded for
  topic        String?
  topicEn      String?
  bodyRaw      String // source-of-truth prose (matches content/reading/*.md)
  bodyHydrated Json? // tokens, pinyin, senses, sentence spans (built at ingest)
  gradeReport  Json? // verification snapshot: band histogram, verdict, metrics
  source       String? // "original" | "storyweaver" | "wikipedia" | ...
  license      String? // "CC-BY-4.0" | "CC-BY-SA-3.0" | "PD" | null = original
  attribution  String?
  status       String   @default("draft") // draft | verified | approved | published
  estimatedMin Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  language Language             @relation(fields: [languageId], references: [id])
  audio    ReadingAudio?
  words    ReadingTextWord[]
  progress ReadingProgress[]
  sessions ReadingSession[]

  @@unique([languageId, slug])
  @@index([languageId, level])
}

// One row per distinct lemma in a text — the join index for per-user
// vocabulary-coverage queries. Written at ingest only.
model ReadingTextWord {
  id       String @id @default(cuid())
  textId   String
  lemma    String // segmented surface form
  level    Int? // HSK band; null = outside the vocabulary list
  position Int // first-occurrence order, stable for listings

  text ReadingText @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@unique([textId, lemma])
  @@index([textId, level])
}

// Pre-generated narration: static MP3 + word-timing sidecar on the audio
// volume. Generated offline (edge-tts); never synthesized at read time.
model ReadingAudio {
  id          String   @id @default(cuid())
  textId      String   @unique
  voice       String
  audioUrl    String // path under the audio base URL
  timingsUrl  String // JSON: { durationMs, marks: [{ s, e, t0, t1 }] }
  durationMs  Int
  generatedAt DateTime @default(now())

  text ReadingText @relation(fields: [textId], references: [id], onDelete: Cascade)
}

// Reading position / completion per user.
model ReadingProgress {
  id           String    @id @default(cuid())
  userId       String
  textId       String
  lastPosition Int       @default(0) // scroll percent 0-100 through bodyRaw, not a char index
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  text ReadingText @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@unique([userId, textId])
}

// One row per reading session (open a story -> leave/finish it). Unlike
// ReadingProgress (single latest position per text), this is append-only and
// repeatable, so it can drive activity metrics (streak, heatmap) and
// preserve re-read history and time-on-task. Deliberately NOT a ReviewLog
// row — ReviewLog's columns (wordId, quality, algorithm, interval deltas)
// are retrieval-shaped and every performance metric (recallRate, lifetime
// reviews) reads them; a reading session has no graded recall to report and
// must never be mistaken for one. See src/lib/readingActivity.ts for the
// union with ReviewLog that feeds streak/heatmap only.
model ReadingSession {
  id         String    @id @default(cuid())
  userId     String
  textId     String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  durationMs Int? // wall-clock time between startedAt and endedAt/last heartbeat
  completed  Boolean   @default(false) // reached the completion threshold (see ReaderView)

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  text ReadingText @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// Lookup log: every tap of the tap dictionary increments lookups. Feeds the
// "add to deck?" nudge (>= 3 lookups) and is deliberately NOT an SRS review —
// reading never touches the scheduler.
model WordEncounter {
  id          String   @id @default(cuid())
  userId      String
  languageId  String
  lemma       String
  lookups     Int      @default(1)
  lastSeenAt  DateTime @default(now())
  addedWordId String? // set when the word was promoted into a deck (Word.id)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([userId, languageId, lemma])
  @@index([userId, languageId])
}
