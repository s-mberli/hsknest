# Copy to .env and fill in. Never commit your real .env.

# Prisma connection string. SQLite file for local dev; a Postgres URL in prod.
DATABASE_URL="file:./dev.db"

# Secret used to sign NextAuth session tokens. Generate a strong value, e.g.:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# Canonical base URL of the app (required in most non-local deployments).
NEXTAUTH_URL="http://localhost:3000"

# Used to build links inside emails (password reset / verification).
# Usually the same as NEXTAUTH_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed/refresh starter word lists (German, Chinese, Spanish) on every boot.
# Idempotent — only creates/updates seeded content, never touches user data.
AUTO_SEED="true"

# Optional: real email delivery via Resend (https://resend.com) for password
# reset and email verification. Without a key, links are logged to the
# server console instead of emailed — fine for local dev/self-hosting.
RESEND_API_KEY=""
EMAIL_FROM="noreply@hsknest.com"

# Self-hosted deployments keep this "true" (the default everywhere): no
# trials, no paywall, no Stripe — billing code is fully bypassed.
# ONLY the managed hosted instance sets SELF_HOSTED="false".
SELF_HOSTED="true"

# Self-hosted only: the first account to sign up claims the instance, then
# registration (and guest mode) closes automatically. Set to "true" to reopen
# both — e.g. to add a second account for someone in your household. Unlike
# SELF_HOSTED, this fails CLOSED: unset or anything other than "true" keeps
# registration closed.
ALLOW_REGISTRATION="false"

# Subscriptions (Hosted mode only)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# Optional: unlocks the read-only operator page at /mb-admin for the
# account with this email. Unset = the page 404s for everyone.
ADMIN_EMAIL=""

# Optional: error tracking via Sentry (https://sentry.io). Free tier available.
# Leave all blank to disable; self-hosters can point SENTRY_DSN at a self-hosted
# Sentry instance or GlitchTip (Sentry-API-compatible, open source).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Optional: cookieless self-hosted Umami analytics. Both must be set for
# the script to load; leave empty to ship no analytics at all.
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Optional: base URL for pre-generated natural pronunciation clips (Azure Neural TTS).
# Set to "/audio" when the clips are mounted at /app/public/audio (same origin),
# or a full URL. Empty = fall back to the browser's Web Speech voice for all
# pronunciation. See docs/AUDIO.md to generate + mount the clips.
NEXT_PUBLIC_AUDIO_BASE_URL=""

# Audio packs to download on container boot (Docker/self-hosted only).
# Space-separated list: "stories" | "words" | "sentences"
# Default: "stories" (Reading Mode narration only; ~10MB)
# Set to "" to skip audio entirely.
AUDIO_PACKS="stories"

# GitHub repository to download audio packs from (Docker/self-hosted only).
# Use the default to fetch from the official s-mberli/hsknest releases.
# Override if using a fork with custom audio.
AUDIO_PACK_REPO="s-mberli/hsknest"

# Ingest Reading Mode's graded stories on every boot (idempotent, same
# pattern as AUTO_SEED). Defaults to "true" — on for everyone, like the rest
# of the starter content. Set to exactly "false" to skip it on a
# stripped-down instance; existing reading progress and enrolled words are
# untouched either way, only future re-ingests are skipped.
READING_MODE_ENABLED="true"
